<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grimório Beyonder - Liuli OSDM v15</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #0c0c0e;
            --panel-bg: #141417;
            --border-color: #4a4a4a;
            --accent-gold: #c5a059;
            --accent-red: #8a1c1c;
            --text-main: #d4d4d4;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Cormorant Garamond', serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            padding: 20px;
        }

        h1, h2, h3, .cinzel { font-family: 'Cinzel', serif; }

        .sheet-wrapper { width: 100%; max-width: 1100px; position: relative; }

        .dossier-container {
            background-color: var(--panel-bg);
            background-image: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.03) 0%, transparent 60%);
            border: 1px solid var(--border-color);
            box-shadow: 0 0 60px rgba(0,0,0,0.8);
            position: relative;
            border-top: 4px solid var(--accent-gold);
            border-bottom: 4px solid var(--accent-gold);
            padding: 40px;
            overflow: hidden;
            min-height: 900px;
        }

        /* Símbolo do Tolo */
        .symbol-fool {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 70%; max-width: 600px; opacity: 0.04; pointer-events: none; z-index: 0;
            filter: drop-shadow(0 0 20px rgba(197, 160, 89, 0.2));
            animation: breathe 8s infinite ease-in-out;
        }
        @keyframes breathe {
            0%, 100% { opacity: 0.04; transform: translate(-50%, -50%) scale(1); }
            50% { opacity: 0.08; transform: translate(-50%, -50%) scale(1.02); }
        }

        input, textarea, select {
            background: rgba(0,0,0,0.2); border: none; border-bottom: 1px solid #444;
            color: #eee; font-family: 'Cormorant Garamond', serif; font-size: 1.1rem;
            transition: all 0.3s ease; width: 100%; position: relative; z-index: 2;
        }
        input:focus, textarea:focus, select:focus {
            outline: none; border-bottom-color: var(--accent-gold); background: rgba(197, 160, 89, 0.05);
        }
        select option { background: #141417; color: #d4d4d4; }

        /* Skill Row OSDM */
        .skill-row {
            display: flex; align-items: center; justify-content: space-between;
            border-bottom: 1px solid #333; padding: 2px 4px; position: relative; z-index: 2;
        }
        .skill-row:hover { background: rgba(255,255,255,0.03); }
        
        /* Select de Nível */
        .skill-select {
            font-size: 0.7rem; color: #aaa; border: 1px solid #333; border-radius: 4px;
            padding: 0 2px; width: auto; margin-right: 8px; cursor: pointer;
            background: rgba(0,0,0,0.3); height: 20px;
        }
        .skill-select:focus { border-color: var(--accent-gold); }

        /* Status Box */
        .stat-box {
            background: linear-gradient(180deg, rgba(30,30,30,0.9) 0%, rgba(10,10,10,0.9) 100%);
            border: 1px solid #333; position: relative; overflow: hidden; z-index: 2;
        }

        /* Tabs */
        .tabs { display: flex; justify-content: center; gap: 20px; margin-bottom: 30px; position: relative; z-index: 10; }
        .tab-btn {
            background: transparent; border: 1px solid #444; color: #888;
            padding: 10px 20px; font-family: 'Cinzel', serif; text-transform: uppercase;
            letter-spacing: 2px; cursor: pointer; transition: all 0.3s;
        }
        .tab-btn:hover { border-color: var(--accent-gold); color: #fff; }
        .tab-btn.active {
            background: linear-gradient(180deg, rgba(197, 160, 89, 0.1) 0%, transparent 100%);
            border-color: var(--accent-gold); color: var(--accent-gold);
            text-shadow: 0 0 10px rgba(197, 160, 89, 0.4);
        }

        .page-content { display: none; animation: fadeIn 0.5s; }
        .page-content.active { display: block; }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Controles */
        .controls {
            position: fixed; top: 20px; right: 20px; display: flex; flex-direction: column; gap: 8px; z-index: 100;
        }
        .btn-control {
            background: #1c1c1e; color: #aaa; border: 1px solid #444; padding: 8px 12px;
            font-size: 11px; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;
            transition: all 0.2s; text-align: left; display: flex; align-items: center; gap: 8px;
            font-family: sans-serif;
        }
        .btn-control:hover { border-color: var(--accent-gold); color: var(--accent-gold); }
        .btn-reset { border-color: #8a1c1c; color: #8a1c1c; font-weight: bold; }
        .btn-reset:hover { background: #8a1c1c; color: white; }

        @media print {
            .controls, .tabs { display: none; }
            body { background: white; -webkit-print-color-adjust: exact; padding: 0; }
            .dossier-container { border: none; box-shadow: none; width: 100%; max-width: none; padding: 0; min-height: auto; }
            input, textarea, select { border-bottom: 1px solid #ccc; color: black; }
            .symbol-fool { opacity: 0.1 !important; filter: none; }
            .page-content { display: block !important; margin-bottom: 50px; page-break-after: always; }
        }
    </style>
</head>
<body>

    <div class="controls" data-html2canvas-ignore="true">
        <button onclick="downloadImage()" class="btn-control">📸 Baixar Tela</button>
        <button onclick="window.print()" class="btn-control">📄 PDF (Completo)</button>
        <div class="h-px bg-stone-700 my-1"></div>
        <button onclick="saveToFile()" class="btn-control">💾 Salvar Arquivo</button>
        <button onclick="document.getElementById('importFile').click()" class="btn-control">📂 Carregar Arquivo</button>
        <input type="file" id="importFile" class="hidden" onchange="loadFromFile(event)">
        <div class="h-px bg-stone-700 my-1"></div>
        <button onclick="resetData()" class="btn-control btn-reset">⚠️ Resetar Tudo</button>
    </div>

    <div class="sheet-wrapper" id="sheetToCapture">
        <div class="dossier-container">
            
            <div class="symbol-fool">
                <svg viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg">
                    <path d="M100 20 Q150 20 180 75 Q150 130 100 130 Q50 130 20 75 Q50 20 100 20 Z" fill="none" stroke="#c5a059" stroke-width="1.5" />
                    <path d="M100 35 C130 35 140 60 140 75 C140 90 130 115 100 115 C70 115 60 90 60 75 C60 60 70 35 100 35" fill="none" stroke="#c5a059" stroke-width="0.8" />
                    <path d="M100 45 C115 45 120 60 120 75 C120 90 115 105 100 105 C85 105 80 90 80 75 C80 60 85 45 100 45" fill="none" stroke="#c5a059" stroke-width="0.5" />
                    <line x1="100" y1="10" x2="100" y2="140" stroke="#c5a059" stroke-width="0.3" stroke-dasharray="2 4" />
                    <line x1="10" y1="75" x2="190" y2="75" stroke="#c5a059" stroke-width="0.3" stroke-dasharray="2 4" />
                </svg>
            </div>

            <header class="text-center mb-8 relative z-10">
                <div class="text-[#8a1c1c] text-4xl mb-2 opacity-80">⚜</div>
                <h1 class="text-5xl md:text-6xl text-[#c5a059] uppercase tracking-widest" style="text-shadow: 0 4px 10px rgba(0,0,0,0.8);">Grimório Beyonder</h1>
                <p class="text-stone-500 italic mt-2 text-lg">"Somos Guardiões, mas também um bando de miseráveis lutando contra ameaças e a prórpia loucura"</p>
                <div class="h-px w-full bg-gradient-to-r from-transparent via-[#c5a059] to-transparent opacity-30 my-6"></div>
            </header>

            <!-- TABS DE NAVEGAÇÃO -->
            <div class="tabs">
                <button class="tab-btn active" onclick="switchTab('page1')">👁️ Perfil & Atributos</button>
                <button class="tab-btn" onclick="switchTab('page2')">🔮 Misticismo & Arsenal</button>
            </div>

            <!-- PÁGINA 1: ATRIBUTOS E PERÍCIAS -->
            <div id="page1" class="page-content active relative z-10">
                
                <!-- Bio -->
                <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                    <div>
                        <label class="cinzel text-xs text-[#c5a059] uppercase tracking-widest">Nome</label>
                        <input type="text" id="name" oninput="saveLocal()">
                    </div>
                    <div>
                        <label class="cinzel text-xs text-[#c5a059] uppercase tracking-widest">Caminho</label>
                        <input type="text" id="path" placeholder="Ex: Marinheiro" oninput="saveLocal()">
                    </div>
                    <div>
                        <label class="cinzel text-xs text-[#c5a059] uppercase tracking-widest">Profissão</label>
                        <input type="text" id="profession_text" placeholder="Ex: Médico" oninput="saveLocal()">
                    </div>
                    <div>
                        <label class="cinzel text-xs text-[#c5a059] uppercase tracking-widest">Sequência</label>
                        <div class="flex items-center gap-2">
                            <input type="number" id="seq_level" value="9" class="text-center" oninput="saveLocal()">
                            <span class="text-xs text-stone-500">Mult:</span>
                            <input type="number" id="seq_mult" value="1" class="text-center text-[#c5a059] font-bold w-12" oninput="calculateAll(); saveLocal()">
                        </div>
                    </div>
                </section>

                <!-- Status Vitais -->
                <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
                    <!-- HP -->
                    <div class="stat-box p-3 text-center rounded border-t-2 border-[#8a1c1c]">
                        <label class="cinzel text-xs text-stone-400 uppercase tracking-widest">Vitalidade (HP)</label>
                        <div class="flex justify-center items-end gap-1">
                            <input type="text" id="hpCur" value="16" class="w-10 text-center text-xl font-bold text-white bg-transparent border-none" oninput="saveLocal()">
                            <span class="text-stone-600 text-lg">/</span>
                            <span id="hpMaxLabel" class="text-xl text-[#8a1c1c] font-bold">16</span>
                        </div>
                        <div class="flex justify-center items-center gap-1 mt-1">
                            <span class="text-[8px] text-stone-600">Mod</span>
                            <input type="number" id="hpAdj" class="w-8 text-[9px] text-center" placeholder="0" oninput="calculateAll(); saveLocal()">
                        </div>
                    </div>
                    <!-- SP -->
                    <div class="stat-box p-3 text-center rounded border-t-2 border-blue-900">
                        <label class="cinzel text-xs text-stone-400 uppercase tracking-widest">Espiritualidade</label>
                        <div class="flex justify-center items-end gap-1">
                            <input type="text" id="spCur" value="16" class="w-10 text-center text-xl font-bold text-white bg-transparent border-none" oninput="saveLocal()">
                            <span class="text-stone-600 text-lg">/</span>
                            <span id="spMaxLabel" class="text-xl text-blue-400 font-bold">16</span>
                        </div>
                        <p class="text-[8px] text-stone-600 mt-1 italic">(INS+WIL)*Mult</p>
                    </div>
                    <!-- SAN -->
                    <div class="stat-box p-3 text-center rounded border-t-2 border-purple-900">
                        <label class="cinzel text-xs text-stone-400 uppercase tracking-widest">Sanidade</label>
                        <div class="flex justify-center items-end gap-1">
                            <input type="text" id="sanCur" value="40" class="w-10 text-center text-xl font-bold text-white bg-transparent border-none" oninput="saveLocal()">
                            <span class="text-stone-600 text-lg">/</span>
                            <span id="sanMaxLabel" class="text-xl text-purple-400 font-bold">40</span>
                        </div>
                        <div class="flex justify-center items-center gap-1 mt-1">
                            <span class="text-[8px] text-stone-600">Mod</span>
                            <input type="number" id="sanAdj" class="w-8 text-[9px] text-center" placeholder="0" oninput="calculateAll(); saveLocal()">
                        </div>
                    </div>
                    <!-- Digestion -->
                    <div class="stat-box p-3 text-center rounded border-t-2 border-[#c5a059]">
                        <label class="cinzel text-xs text-stone-400 uppercase tracking-widest">Digestão</label>
                        <div class="flex justify-center items-center h-full pb-2">
                            <input type="text" id="digestion" value="0%" class="text-center text-xl font-bold text-[#c5a059] bg-transparent border-none" oninput="saveLocal()">
                        </div>
                    </div>
                </section>

                <!-- Atributos e Perícias -->
                <section class="grid grid-cols-1 md:grid-cols-12 gap-8">
                    
                    <!-- Atributos -->
                    <div class="md:col-span-4 space-y-3">
                        <h3 class="cinzel text-sm text-white border-b border-[#c5a059] pb-1 mb-4 flex justify-between">
                            <span>Atributos</span> <span class="text-[10px] text-stone-500">Base</span>
                        </h3>
                        <div id="attributesContainer" class="space-y-2"></div>
                    </div>

                    <!-- Perícias -->
                    <div class="md:col-span-8">
                        <h3 class="cinzel text-sm text-white border-b border-[#c5a059] pb-1 mb-4 flex justify-between">
                            <span>Perícias OSDM</span> 
                            <div class="text-[9px] text-stone-500 flex gap-1">
                                <span>Dest(-4)</span>
                                <span>Tre(+2)</span>
                                <span class="text-[#c5a059]">Pro(+4)</span>
                                <span>Ava(+5)</span>
                            </div>
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-0" id="skillsContainer"></div>
                    </div>
                </section>
                
                <!-- Âncoras -->
                <section class="mt-8">
                    <h3 class="cinzel text-xs text-purple-400 uppercase tracking-widest mb-2 border-b border-purple-900 pb-1">Âncoras de Humanidade</h3>
                    <textarea id="anchors" class="w-full h-16 bg-transparent border-none text-sm text-stone-400 p-2" placeholder="O que te mantém são..." oninput="saveLocal()"></textarea>
                </section>

            </div>

            <!-- PÁGINA 2: MISTICISMO E ARTEFATOS -->
            <div id="page2" class="page-content relative z-10">
                
                <!-- Habilidades de Sequência -->
                <section class="mb-10">
                    <h3 class="cinzel text-lg text-[#c5a059] border-b border-[#c5a059] pb-2 mb-4 flex items-center gap-2">
                        <span>⚡ Habilidades de Sequência</span>
                    </h3>
                    <textarea id="abilities_full" class="w-full h-64 bg-[#0a0a0a] border border-stone-800 p-4 text-sm text-stone-300 leading-relaxed focus:border-[#c5a059]" placeholder="Descreva aqui os poderes da sua poção...&#10;Ex: Visão Espiritual (1 SP) - Permite ver auras..." oninput="saveLocal()"></textarea>
                </section>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    
                    <!-- Rituais -->
                    <section>
                        <h3 class="cinzel text-sm text-white border-b border-stone-700 pb-2 mb-4 uppercase tracking-widest">
                            🕯️ Rituais Conhecidos
                        </h3>
                        <textarea id="rituals" class="w-full h-48 bg-[#0a0a0a] border border-stone-800 p-3 text-sm text-stone-400" placeholder="Rituais de sorte, divinação..." oninput="saveLocal()"></textarea>
                    </section>

                    <!-- Amuletos -->
                    <section>
                        <h3 class="cinzel text-sm text-white border-b border-stone-700 pb-2 mb-4 uppercase tracking-widest">
                            🧿 Amuletos & Consumíveis
                        </h3>
                        <textarea id="charms" class="w-full h-48 bg-[#0a0a0a] border border-stone-800 p-3 text-sm text-stone-400" placeholder="Amuletos de estanho, óleos..." oninput="saveLocal()"></textarea>
                    </section>
                </div>

                <!-- Artefatos Selados -->
                <section class="mt-10">
                    <h3 class="cinzel text-sm text-[#8a1c1c] border-b border-[#8a1c1c] pb-2 mb-4 uppercase tracking-widest flex justify-between">
                        <span>🩸 Itens Selados / Místicos</span>
                        <span class="text-[9px] opacity-50">Cuidado com a Corrupção</span>
                    </h3>
                    
                    <!-- Tabela Manual de Artefatos -->
                    <div class="space-y-4">
                        <div class="bg-black/20 border border-stone-800 p-3 rounded">
                            <div class="flex gap-2 mb-2">
                                <input type="text" id="art1_name" placeholder="Nome do Artefato (Ex: 3-044)" class="font-bold text-[#c5a059]" oninput="saveLocal()">
                                <input type="text" id="art1_rank" placeholder="Rank" class="w-16 text-center text-xs" oninput="saveLocal()">
                            </div>
                            <textarea id="art1_desc" class="w-full h-16 bg-transparent text-xs text-stone-400 border-none p-0" placeholder="Efeito e Efeito Negativo..." oninput="saveLocal()"></textarea>
                        </div>

                        <div class="bg-black/20 border border-stone-800 p-3 rounded">
                            <div class="flex gap-2 mb-2">
                                <input type="text" id="art2_name" placeholder="Nome do Artefato" class="font-bold text-[#c5a059]" oninput="saveLocal()">
                                <input type="text" id="art2_rank" placeholder="Rank" class="w-16 text-center text-xs" oninput="saveLocal()">
                            </div>
                            <textarea id="art2_desc" class="w-full h-16 bg-transparent text-xs text-stone-400 border-none p-0" placeholder="Efeito e Efeito Negativo..." oninput="saveLocal()"></textarea>
                        </div>
                    </div>
                </section>

                <section class="mt-8">
                    <h3 class="cinzel text-xs text-stone-500 uppercase tracking-widest mb-2">Inventário Mundano</h3>
                    <textarea id="inventory" class="w-full h-24 bg-transparent border-stone-800 p-2 text-xs text-stone-500" placeholder="Dinheiro, roupas, chaves..." oninput="saveLocal()"></textarea>
                </section>

            </div>

        </div>
    </div>

<script>
    // --- 1. DADOS DE SISTEMA (BASEADO NO ARQUIVO OSDM) ---
    const attributesList = [
        { id: 'str', name: 'Força (FOR)' },
        { id: 'agi', name: 'Agilidade (AGI)' },
        { id: 'con', name: 'Constituição (CON)' },
        { id: 'int', name: 'Inteligência (INT)' },
        { id: 'ins', name: 'Inspiração (INS)' },
        { id: 'edu', name: 'Educação (EDU)' },
        { id: 'wil', name: 'Vontade (WIL)' },
        { id: 'cha', name: 'Carisma (CHA)' },
        { id: 'luc', name: 'Sorte (LUC)' } 
    ];

    const skillsList = [
        // Força
        { id: 'escalada', name: 'Escalada', attr: 'str' },
        { id: 'natacao', name: 'Natação', attr: 'str' },
        { id: 'arremesso', name: 'Arremesso', attr: 'str' },
        { id: 'briga', name: 'Briga', attr: 'str' },
        { id: 'intimid', name: 'Intimidação', attr: 'str' },
        { id: 'salto', name: 'Salto', attr: 'str' },
        { id: 'sobrev', name: 'Sobrevivência', attr: 'str' }, 
        { id: 'peso', name: 'Levantamento de Peso', attr: 'str' },
        { id: 'adestra', name: 'Adestramento', attr: 'str' },
        
        // Educação
        { id: 'direito', name: 'Direito', attr: 'edu' },
        { id: 'arqueo', name: 'Arqueologia', attr: 'edu' },
        { id: 'religiao', name: 'Religião', attr: 'edu' },
        { id: 'naveg', name: 'Navegação', attr: 'edu' },
        { id: 'comercio', name: 'Comércio', attr: 'edu' },
        { id: 'medicina', name: 'Medicina', attr: 'edu' },
        { id: 'ciencia', name: 'Ciência (Espec.)', attr: 'edu' },
        { id: 'fabric', name: 'Fabricação', attr: 'edu' },
        { id: 'hist', name: 'História', attr: 'edu' },
        { id: 'bibli', name: 'Uso de Biblioteca', attr: 'edu' },

        // Agilidade
        { id: 'furtiv', name: 'Furtividade', attr: 'agi' },
        { id: 'prest', name: 'Prestidigitação', attr: 'agi' },
        { id: 'tiro', name: 'Tiro', attr: 'agi' },
        { id: 'arromba', name: 'Arrombamento', attr: 'agi' },
        { id: 'rastreio', name: 'Rastreamento', attr: 'agi' },
        { id: 'direcao', name: 'Direção', attr: 'agi' },
        { id: 'esquiva', name: 'Esquiva', attr: 'agi' }, 

        // Inspiração
        { id: 'escutar', name: 'Escutar', attr: 'ins' },
        { id: 'invest', name: 'Investigar', attr: 'ins' },
        { id: 'reparos', name: 'Reparos', attr: 'ins' },
        { id: 'ocult', name: 'Ocultismo', attr: 'ins' },
        { id: 'psico', name: 'Psicologia', attr: 'ins' },
        { id: 'culinaria', name: 'Culinária', attr: 'ins' },

        // Carisma
        { id: 'persu', name: 'Persuasão', attr: 'cha' },
        { id: 'engan', name: 'Enganação', attr: 'cha' },
        { id: 'atuacao', name: 'Atuação (Acting)', attr: 'cha' },

        // Sorte
        { id: 'jogos', name: 'Jogos de Azar', attr: 'luc' },
        { id: 'boatos', name: 'Boatos', attr: 'luc' },
        { id: 'orient', name: 'Orientação Instintiva', attr: 'luc' }
    ];

    // --- TABS LOGIC ---
    function switchTab(tabId) {
        document.querySelectorAll('.page-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
        
        document.getElementById(tabId).classList.add('active');
        event.target.classList.add('active');
    }

    // --- 2. RENDERIZAÇÃO ---
    function renderUI() {
        const attrContainer = document.getElementById('attributesContainer');
        if (attrContainer) {
            let html = '';
            attributesList.forEach(a => {
                html += `
                <div class="flex justify-between items-center">
                    <span class="cinzel text-stone-400 text-xs uppercase tracking-wide">${a.name}</span>
                    <input type="number" id="attr_${a.id}" value="8" class="w-10 text-center text-[#c5a059] font-bold bg-black/20 border border-stone-700 rounded text-sm" oninput="calculateAll(); saveLocal()">
                </div>`;
            });
            attrContainer.innerHTML = html;
        }

        const skillContainer = document.getElementById('skillsContainer');
        if (skillContainer) {
            let html = '';
            skillsList.forEach(s => {
                html += `
                <div id="row_${s.id}" class="skill-row">
                    <div class="flex items-center gap-2 flex-1">
                        <span class="skill-label cinzel text-xs text-stone-500 tracking-wide transition-colors flex-1">${s.name} <span class="text-[8px] opacity-40 font-sans ml-1">${s.attr.toUpperCase()}</span></span>
                        <select id="skill_${s.id}" class="skill-select bg-transparent text-xs" onchange="calculateAll(); saveLocal()">
                            <option value="0">Destr. (-4)</option>
                            <option value="1">Treinado (+2)</option>
                            <option value="2">Prof. (+4)</option>
                            <option value="3">Avan. (+5)</option>
                        </select>
                    </div>
                    <span id="val_${s.id}" class="text-[#c5a059] font-bold min-w-[25px] text-right font-mono text-xs">-4</span>
                </div>`;
            });
            skillContainer.innerHTML = html;
        }
    }

    // --- 3. CÁLCULO ---
    function calculateAll() {
        try {
            const seqMult = parseFloat(document.getElementById('seq_mult').value) || 1;
            const hpAdj = parseInt(document.getElementById('hpAdj').value) || 0;
            const sanAdj = parseInt(document.getElementById('sanAdj').value) || 0;

            const vals = {};
            attributesList.forEach(a => {
                const el = document.getElementById(`attr_${a.id}`);
                vals[a.id] = el ? (parseInt(el.value) || 0) : 0;
            });

            document.getElementById('hpMaxLabel').innerText = (vals.con * 2) + hpAdj;
            document.getElementById('spMaxLabel').innerText = Math.floor((vals.ins + vals.wil) * seqMult);
            document.getElementById('sanMaxLabel').innerText = (vals.wil * 5) + sanAdj;

            skillsList.forEach(s => {
                const base = vals[s.attr] || 0;
                const select = document.getElementById(`skill_${s.id}`);
                const level = select ? parseInt(select.value) : 0;
                
                let bonus = -4; // Destreinado
                if (level === 1) bonus = 2; // Treinado
                if (level === 2) bonus = 4; // Proficiente
                if (level === 3) bonus = 5; // Avançado

                const total = base + bonus;
                
                const spanVal = document.getElementById(`val_${s.id}`);
                if(spanVal) {
                    spanVal.innerText = (total >= 0 ? '+' : '') + total;
                    if(bonus < 0) spanVal.style.color = '#8a1c1c';
                    else spanVal.style.color = '#c5a059';
                }

                const label = document.querySelector(`#row_${s.id} .skill-label`);
                if(label) {
                    if(level > 0) label.style.color = '#c5a059';
                    else label.style.color = '';
                }
            });
        } catch (e) { console.error(e); }
    }

    // --- 4. PERSISTÊNCIA ---
    function saveLocal() {
        const data = {};
        document.querySelectorAll('input, select, textarea').forEach(el => {
            if(el.type === 'checkbox') data[el.id] = el.checked;
            else data[el.id] = el.value;
        });
        localStorage.setItem('lom_v15_grim_osdm', JSON.stringify(data));
    }

    function loadLocal() {
        try {
            const saved = localStorage.getItem('lom_v15_grim_osdm');
            if(saved) {
                const data = JSON.parse(saved);
                Object.keys(data).forEach(key => {
                    const el = document.getElementById(key);
                    if(el) {
                        if(el.type === 'checkbox') el.checked = data[key];
                        else el.value = data[key];
                    }
                });
            }
            calculateAll();
        } catch(e) { console.error("Erro load", e); }
    }

    function resetData() {
        if(confirm("Apagar ficha?")) { localStorage.removeItem('lom_v15_grim_osdm'); location.reload(); }
    }

    function saveToFile() {
        const data = localStorage.getItem('lom_v15_grim_osdm');
        const blob = new Blob([data], {type: 'application/json'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Grimorio_${document.getElementById('name').value}.json`;
        a.click();
    }

    function loadFromFile(e) {
        const file = e.target.files[0];
        if(!file) return;
        const reader = new FileReader();
        reader.onload = function(ev) {
            localStorage.setItem('lom_v15_grim_osdm', ev.target.result);
            location.reload();
        }
        reader.readAsText(file);
    }

    function downloadImage() {
        const el = document.getElementById('sheetToCapture');
        el.style.boxShadow = "none";
        html2canvas(el, { backgroundColor: "#141417", scale: 2 }).then(canvas => {
            const link = document.createElement('a');
            link.download = `Grimorio_${document.getElementById('name').value}.png`;
            link.href = canvas.toDataURL("image/png");
            link.click();
            el.style.boxShadow = "";
        });
    }

    // --- 5. START ---
    window.onload = function() {
        renderUI();
        setTimeout(loadLocal, 100);
    };

</script>

</body>
</html>
